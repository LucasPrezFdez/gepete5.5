# Neon Postgres
DATABASE_URL=

# Token secreto para firmar JWT propios (auth.ts)
AUTH_SECRET=

# URL pública del sitio (sin barra final). Se usa para metadata, sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meilisearch (búsqueda full-text)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# Integraciones de catálogo
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=

# Nivel mínimo de log (debug | info | warn | error)
LOG_LEVEL=info

# Chat IA (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Token para autorizar el endpoint /api/cron/check-releases (notifs de lanzamiento).
# Llama al endpoint con `Authorization: Bearer <CRON_SECRET>` o `?token=<CRON_SECRET>`.
CRON_SECRET=

# Lista de emails (separados por coma) que son administradores del panel /admin.
# La marca se aplica en cada login: quitar un email aquí revoca admin en el siguiente signin.
# No hay UI para promover/degradar — el flag se controla solo desde esta variable.
ADMIN_EMAILS=
