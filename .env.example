# Neon Postgres
DATABASE_URL=

# Token secreto para firmar JWT propios (auth.ts)
AUTH_SECRET=

# URL pública del sitio (sin barra final). Se usa para metadata, sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meilisearch (búsqueda full-text)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# Integraciones de catálogo
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
RAWG_API_KEY=

# Nivel mínimo de log (debug | info | warn | error)
LOG_LEVEL=info
